APP_NAME="SmartDesk-AI"
VERSION="0.1"
OPEN_API_KEYS=""
FILE_DEFAULT_CHUNK_SIZE=1024

#Postgres Variables
POSTGRES_USERNAME="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_HOST="pgvector"
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE="mini-rag"


# ==========LLM Config ================
GENERATION_BACKEND_LITERAL=["OPENAI","COHERE"]
GENERATION_BACKEND="COHERE"
EMBEDDING_BACKEND="COHERE"

# ========== OPENAI Config ============
OPEN_API_KEYS=""
OPEN_API_URL=""

# ========== COHERE Config ============
COHERE_API_KEY=""

GENERATION_MODEL_ID="tiny-aya-fire"
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE=384

INPUT_DEFAULT_MAX_CHARACTERS=1024
GENERATION_DEFAULT_MAX_TOKENS=200
GENERATION_DEFAULT_TEMPERATURE=0.1


# ============Vector DB config ===========
VECTOR_DB_BACKEND_LITERAL=["QDRANT", "PGVECTOR"]
VECTOR_DB_BACKEND="PGVECTOR"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="Cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD=500
VECTOR_DB_DEFAULT_VECTOR_SIZE=384


#===============Template config============
PRIMARY_LANGUAGE="en"
DEFAULT_LANGUAGE="en"

#===============SMTP SENDER+=============

SMTP_SERVER=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=support@smartdesk.ai
SMTP_USE_TLS=True



